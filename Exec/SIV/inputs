# SIV N-body run: 8^3 box, Omega_m=0.30, z_init=9 -> z=0
# Low-res local test of the full SIV pipeline (Change 1+2+3).
max_step = 200

nyx.initial_z = 9.0
nyx.final_a   = 1.0

amr.data_log = runlog

gravity.no_sync      = 1
gravity.no_composite = 1

geometry.is_periodic = 1 1 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0. 0. 0.
geometry.prob_hi     = 32. 32. 32.

amr.n_cell        = 8 8 8
amr.max_grid_size = 8
amr.max_level     = 0
amr.blocking_factor = 8

nyx.lo_bc = 0 0 0
nyx.hi_bc = 0 0 0

nyx.do_hydro = 0
